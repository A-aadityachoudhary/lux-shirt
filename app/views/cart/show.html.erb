<div class="max-w-5xl mx-auto px-6 py-8">

  <h1 class="text-3xl font-bold mb-8">
    Your Cart
  </h1>

  <% grand_total = 0 %>

  <% if @cart.order_items.any? %>

    <% @cart.order_items.each do |item| %>

      <div class="bg-white rounded-xl shadow-md p-6 mb-6 flex flex-col md:flex-row gap-6">

        <div>
          <% if item.product.product_images.attached? %>
            <%= image_tag item.product.product_images.first,
                class: "w-40 h-40 object-cover rounded-lg border" %>
          <% end %>
        </div>

        <div class="flex-1">

          <h3 class="text-xl font-semibold mb-2">
            <%= item.product.title %>
          </h3>

          <p class="text-gray-600 mb-2">
            Price: ₹<%= item.product.price %>
          </p>

          <p class="text-gray-600 mb-4">
            Quantity: <%= item.quantity %>
          </p>

          <div class="flex items-center gap-3 mb-4">

            <%= button_to "-",
                reduce_quantity_order_item_path(item),
                method: :patch,
                class: "bg-red-500 hover:bg-red-600 text-white w-10 h-10 rounded-lg font-bold" %>

            <span class="text-lg font-semibold">
              <%= item.quantity %>
            </span>

            <%= button_to "+",
                increase_quantity_order_item_path(item),
                method: :patch,
                class: "bg-green-500 hover:bg-green-600 text-white w-10 h-10 rounded-lg font-bold" %>

          </div>

          <p class="text-lg font-bold text-green-600">
            Subtotal: ₹<%= item.quantity * item.product.price %>
          </p>

        </div>

      </div>

      <% grand_total += item.quantity * item.product.price %>

    <% end %>

    <div class="bg-white rounded-xl shadow-md p-6">

      <div class="flex justify-between items-center">

        <h2 class="text-2xl font-bold">
          Grand Total
        </h2>

        <h2 class="text-3xl font-bold text-green-600">
          ₹<%= grand_total %>
        </h2>

      </div>

      <div class="mt-6">

        <%= link_to "Proceed To Checkout",
            new_order_path,
            class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-semibold" %>

      </div>

    </div>

  <% else %>

    <div class="bg-white rounded-xl shadow-md p-10 text-center">

      <h2 class="text-2xl font-semibold text-gray-700 mb-3">
        Your cart is empty
      </h2>

      <p class="text-gray-500 mb-6">
        Add some shirts to get started.
      </p>

      <%= link_to "Continue Shopping",
          products_path,
          class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg" %>

    </div>

  <% end %>

</div>