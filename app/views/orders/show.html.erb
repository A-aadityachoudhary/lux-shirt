<div class="max-w-4xl mx-auto px-4 py-8">
  <div class="bg-[#12131c]/90 border border-gray-800 rounded-3xl p-8 shadow-[0_30px_60px_rgba(0,0,0,0.4)]">
    
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 pb-6 border-b border-gray-800">
      <div>
        <h1 class="text-3xl font-black text-white tracking-tight">Order Details Ledger</h1>
        <p class="text-xs text-gray-500 font-mono mt-1">Transaction ID Reference Key: #<%= @order.id %></p>
      </div>
      <div class="text-left sm:text-right">
        <span class="inline-block bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 px-5 py-2 rounded-full font-bold text-xs tracking-wider uppercase">
          <%= @order.status.presence || "Settled" %>
        </span>
        <p class="text-xs text-gray-400 font-medium mt-2"><%= @order.created_at.strftime("%d %B %Y at %H:%M Local") %></p>
      </div>
    </div>

    <% if Current.user.role == "admin" && @order.user.present? %>
      <div class="mt-6 p-4 bg-indigo-950/20 border border-indigo-500/20 rounded-2xl flex items-center justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-indigo-400">Customer Identity Account</p>
          <p class="text-white font-bold text-lg mt-0.5"><%= @order.user.name %></p>
          <p class="text-sm text-gray-400"><%= @order.user.email_address %></p>
        </div>
        <div class="text-right text-xs text-gray-500 font-semibold">
          User Database Key: ID_<%= @order.user.id %>
        </div>
      </div>
    <% end %>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-8">
      <div class="p-5 bg-[#1a1b26]/60 border border-gray-800/80 rounded-2xl">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Delivery Coordinates</h3>
        <p class="text-gray-200 text-sm font-medium leading-relaxed whitespace-pre-line"><%= @order.shipping_address %></p>
      </div>
      <div class="p-5 bg-[#1a1b26]/60 border border-gray-800/80 rounded-2xl">
        <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-2">Method of Settlement</h3>
        <p class="text-white text-lg font-bold"><%= @order.payment_method == "COD" ? "💸 Cash On Delivery (COD)" : @order.payment_method %></p>
        <p class="text-xs text-gray-400 mt-1">Surcharge processing parameters checked and approved.</p>
      </div>
    </div>

    <h2 class="text-lg font-bold text-gray-300 tracking-wide uppercase mb-4">Itemized Manifest</h2>
    <div class="space-y-4">
      <% @order.order_items.each do |item| %>
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between border border-gray-800 bg-[#1a1b26]/30 rounded-2xl p-4 gap-4">
          <div class="flex items-center gap-4">
            <% if item.product.product_images.attached? %>
              <%= image_tag item.product.product_images.first, class: "w-16 h-16 object-cover rounded-xl border border-gray-700/60 shadow-md" %>
            <% else %>
              <div class="w-16 h-16 bg-[#1a1b26] border border-gray-800 rounded-xl"></div>
            <% end %>
            <div>
              <h3 class="font-bold text-base text-white"><%= item.product.title %></h3>
              <p class="text-gray-400 text-sm font-medium">Base Unit Price: ₹<%= item.product.price %></p>
            </div>
          </div>

          <div class="text-left sm:text-right w-full sm:w-auto flex sm:flex-col justify-between items-center sm:items-end border-t sm:border-0 border-gray-800/60 pt-3 sm:pt-0">
            <p class="text-gray-400 font-medium text-sm">Quantity Count: <span class="text-white font-bold"><%= item.quantity %></span></p>
            <p class="text-emerald-400 font-extrabold text-base sm:mt-0.5">Subtotal: ₹<%= item.quantity * item.product.price %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="border-t border-gray-800 my-8"></div>
    <div class="flex justify-between items-center bg-[#1a1b26] border border-gray-800 p-6 rounded-2xl shadow-inner">
      <h2 class="text-lg font-bold text-gray-400 uppercase tracking-wider">Final Reconciled Balance</h2>
      <h2 class="text-4xl font-black text-emerald-400 tracking-tight">
        ₹<%= @order.total_amount.presence || @order.order_items.sum { |i| i.quantity * i.product.price } %>
      </h2>
    </div>

    <div class="mt-8 flex gap-4">
      <%= link_to "Back to Audit List", orders_path, class: "inline-block bg-gray-800 hover:bg-gray-700 text-white border border-gray-700 px-6 py-3 rounded-xl font-semibold transition text-sm tracking-wide" %>
    </div>
  </div>
</div>