<div class="max-w-4xl mx-auto px-6 py-8">

  <div class="bg-white shadow-lg rounded-xl p-8">

    <div class="flex justify-between items-center mb-6">

      <h1 class="text-3xl font-bold">
        Order #<%= @order.id %>
      </h1>

      <span class="bg-green-100 text-green-700 px-4 py-2 rounded-full font-medium">
        <%= @order.status %>
      </span>

    </div>

    <hr class="mb-6">

    <h2 class="text-xl font-semibold mb-4">
      Ordered Items
    </h2>

    <div class="space-y-4">

      <% @order.order_items.each do |item| %>

        <div class="flex items-center justify-between border rounded-lg p-4">

          <div class="flex items-center gap-4">

            <% if item.product.product_images.attached? %>
              <%= image_tag item.product.product_images.first,
                  class: "w-20 h-20 object-cover rounded-lg border" %>
            <% end %>

            <div>

              <h3 class="font-semibold text-lg">
                <%= item.product.title %>
              </h3>

              <p class="text-gray-600">
                ₹<%= item.product.price %>
              </p>

            </div>

          </div>

          <div class="text-right">

            <p class="font-medium">
              Qty: <%= item.quantity %>
            </p>

            <p class="text-green-600 font-bold">
              ₹<%= item.quantity * item.product.price %>
            </p>

          </div>

        </div>

      <% end %>

    </div>

    <hr class="my-6">

    <div class="flex justify-between items-center">

      <h2 class="text-2xl font-bold">
        Total Amount
      </h2>

      <h2 class="text-3xl font-bold text-green-600">
        ₹<%= @order.total_amount %>
      </h2>

    </div>

    <div class="mt-8">

      <%= link_to "Back To Orders",
          orders_path,
          class: "inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg font-medium" %>

    </div>

  </div>

</div>