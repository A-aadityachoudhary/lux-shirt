<div class="max-w-2xl mx-auto px-4 py-10">
  <div class="bg-[#12131c]/90 border border-gray-800 rounded-3xl p-8 shadow-[0_20px_50px_rgba(0,0,0,0.4)] backdrop-blur-sm">
    <h1 class="text-3xl font-extrabold text-center text-white tracking-tight mb-8">
      Checkout Details
    </h1>

    <%= form_with model: @order, class: "space-y-6" do |f| %>
      <div>
        <%= f.label :shipping_address,
            class: "block text-sm font-semibold text-gray-300 mb-2 tracking-wide" %>
        <%= f.text_area :shipping_address,
            rows: 4,
            placeholder: "Enter full delivery destination...",
            class: "w-full bg-[#1a1b26] text-white rounded-xl border border-gray-700 px-4 py-3 focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none transition duration-200 placeholder-gray-600 shadow-inner" %>
      </div>

      <div>
        <%= f.label :payment_method,
            class: "block text-sm font-semibold text-gray-300 mb-2 tracking-wide" %>
        <%= f.select :payment_method,
            [["Cash On Delivery", "COD"]],
            {},
            class: "w-full bg-[#1a1b26] text-white rounded-xl border border-gray-700 px-4 py-3 focus:ring-2 focus:ring-emerald-500 focus:border-transparent outline-none transition duration-200 shadow-inner cursor-pointer" %>
      </div>

      <div class="pt-6">
        <%= f.submit "Place Order",
            class: "w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-4 rounded-xl shadow-[0_4px_20px_rgba(16,185,129,0.3)] hover:shadow-[0_6px_24px_rgba(16,185,129,0.5)] transform hover:-translate-y-0.5 transition duration-200 cursor-pointer tracking-wider uppercase text-sm" %>
      </div>
    <% end %>
  </div>
</div>