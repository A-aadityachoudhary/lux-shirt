<div class="max-w-2xl mx-auto mt-10">

  <div class="bg-white shadow-lg rounded-xl p-8">

    <h1 class="text-3xl font-bold text-center mb-8">
      Checkout
    </h1>

    <%= form_with model: @order, class: "space-y-6" do |f| %>

      <div>
        <%= f.label :name,
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.text_field :name,
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :email,
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.email_field :email,
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :address,
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.text_area :address,
            rows: 4,
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div>
        <%= f.label :pay_method,
            "Payment Method",
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.select :pay_method,
            [["Cash On Delivery", "COD"]],
            {},
            class: "w-full border border-gray-300 rounded-lg px-4 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Place Order",
            class: "w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-lg shadow-md transition duration-200 cursor-pointer" %>
      </div>

    <% end %>

  </div>

</div>