<div class="max-w-2xl mx-auto px-6 py-10">

  <div class="bg-white shadow-lg rounded-2xl p-8">

    <h1 class="text-3xl font-bold text-center text-gray-800 mb-8">
      Checkout
    </h1>

    <%= form_with model: @order, class: "space-y-6" do |f| %>

      <div>
        <%= f.label :shipping_address,
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.text_area :shipping_address,
            rows: 5,
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none" %>
      </div>

      <div>
        <%= f.label :payment_method,
            class: "block text-sm font-medium text-gray-700 mb-2" %>

        <%= f.select :payment_method,
            [["Cash On Delivery", "COD"]],
            {},
            class: "w-full rounded-lg border border-gray-300 px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none bg-white" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Place Order",
            class: "w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-3 rounded-lg shadow-md transition duration-200 cursor-pointer" %>
      </div>

    <% end %>

  </div>

</div>