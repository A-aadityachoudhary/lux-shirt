<!DOCTYPE html>
<html>
  <head>
    <title>Lux Shirt</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">

    <nav class="bg-black text-white shadow-lg">

      <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">

        <%= link_to "Lux Shirt",
            root_path,
            class: "text-2xl font-bold tracking-wide" %>

        <div class="flex items-center gap-6">

          <%= link_to "Products",
              products_path,
              class: "hover:text-gray-300" %>

          <% if Current.user %>

            <%= link_to "Orders",
                orders_path,
                class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-lg font-medium" %>

            <% if Current.user.role == "admin" %>

              <%= link_to "Admin Panel",
                  admin_products_path,
                  class: "bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg" %>

            <% end %>

            <%= link_to "Cart",
                cart_path(@current_cart),
                class: "bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg" %>

            <%= button_to "Logout",
                session_path,
                method: :delete,
                class: "bg-red-600 hover:bg-red-700 px-4 py-2 rounded-lg" %>

          <% else %>

            <%= link_to "Login",
                new_session_path,
                class: "bg-blue-600 hover:bg-blue-700 px-4 py-2 rounded-lg" %>

            <%= link_to "Register",
                new_user_path,
                class: "bg-green-600 hover:bg-green-700 px-4 py-2 rounded-lg" %>

          <% end %>

        </div>

      </div>

    </nav>

    <div class="max-w-7xl mx-auto px-6 py-4">

      <% if notice %>
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded-lg mb-4">
          <%= notice %>
        </div>
      <% end %>

      <% if alert %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded-lg mb-4">
          <%= alert %>
        </div>
      <% end %>

      <%= yield %>

    </div>

  </body>
</html>