<div class="max-w-7xl mx-auto px-6 py-10">

  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">

    <div class="grid md:grid-cols-2 gap-8 p-8">

      <!-- Product Images -->
      <div>

        <% if @product.product_images.attached? %>

          <div class="space-y-4">

            <% @product.product_images.each do |image| %>

              <%= image_tag image,
                  class: "w-full rounded-xl border shadow-sm" %>

            <% end %>

          </div>

        <% else %>

          <div class="h-96 bg-gray-200 rounded-xl flex items-center justify-center text-gray-500">
            No Image Available
          </div>

        <% end %>

      </div>

      <!-- Product Details -->
      <div class="flex flex-col justify-center">

        <h1 class="text-4xl font-bold text-gray-800 mb-4">
          <%= @product.title %>
        </h1>

        <p class="text-gray-600 text-lg mb-6">
          <%= @product.description %>
        </p>

        <h2 class="text-4xl font-bold text-green-600 mb-6">
          ₹<%= @product.price %>
        </h2>

        <div class="mb-6">

          <% if @product.stock > 0 %>

            <span class="bg-green-100 text-green-700 px-4 py-2 rounded-full font-medium">
              In Stock (<%= @product.stock %>)
            </span>

          <% else %>

            <span class="bg-red-100 text-red-700 px-4 py-2 rounded-full font-medium">
              Out Of Stock
            </span>

          <% end %>

        </div>

        <% if @product.stock > 0 %>

          <%= button_to "🛒 Add To Cart",
              order_items_path(product_id: @product.id),
              class: "bg-blue-600 hover:bg-blue-700 text-white text-lg font-semibold px-6 py-3 rounded-xl shadow-md transition" %>

        <% else %>

          <button disabled
            class="bg-gray-400 text-white text-lg font-semibold px-6 py-3 rounded-xl cursor-not-allowed">
            Out Of Stock
          </button>

        <% end %>

      </div>

    </div>

  </div>

</div>