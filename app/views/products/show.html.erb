<div class="max-w-7xl mx-auto px-4 py-10">
  <div class="bg-[#12131c]/90 border border-gray-800 rounded-3xl shadow-[0_30px_60px_rgba(0,0,0,0.4)] overflow-hidden">
    <div class="grid lg:grid-cols-2 gap-12 p-8 lg:p-12">
      
      <div class="space-y-4">
        <% if @product.product_images.attached? %>
          <div class="grid grid-cols-1 gap-4">
            <% @product.product_images.each do |image| %>
              <div class="overflow-hidden rounded-2xl border border-gray-800 bg-[#1a1b26] shadow-md">
                <%= image_tag image,
                    class: "w-full h-auto object-cover transform hover:scale-105 transition duration-500" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="h-96 bg-[#1a1b26] border border-gray-800 rounded-2xl flex items-center justify-center text-gray-600">
            No Image Available
          </div>
        <% end %>
      </div>

      <div class="flex flex-col justify-center">
        <h1 class="text-4xl lg:text-5xl font-black text-white mb-4 tracking-tight leading-none">
          <%= @product.title %>
        </h1>

        <p class="text-gray-400 text-lg mb-8 font-light leading-relaxed">
          <%= @product.description %>
        </p>

        <div class="flex items-baseline gap-4 mb-6">
          <span class="text-5xl font-black text-emerald-400 tracking-tight">
            ₹<%= @product.price %>
          </span>
        </div>

        <div class="mb-8">
          <% if @product.stock > 0 %>
            <span class="inline-flex items-center gap-2 bg-emerald-950/80 border border-emerald-500/30 text-emerald-400 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
              In Stock (<%= @product.stock %>)
            </span>
          <% else %>
            <span class="inline-flex items-center bg-rose-950/80 border border-rose-500/30 text-rose-400 px-4 py-1.5 rounded-full text-xs font-bold tracking-wider uppercase">
              Out Of Stock
            </span>
          <% end %>
        </div>

        <div class="pt-4 border-t border-gray-800/80">
          <% if @product.stock > 0 %>
            <%= button_to order_items_path(product_id: @product.id),
                class: "w-full sm:w-auto bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white text-lg font-bold px-10 py-4 rounded-xl shadow-[0_4px_25px_rgba(16,185,129,0.3)] hover:shadow-[0_6px_30px_rgba(16,185,129,0.5)] transform hover:-translate-y-1 transition-all duration-200 cursor-pointer text-center flex items-center justify-center gap-2" do %>
              <span>🛒</span> Add To Cart
            <% end %>
          <% else %>
            <button disabled
              class="w-full sm:w-auto bg-gray-800 text-gray-500 text-lg font-bold px-10 py-4 rounded-xl border border-gray-700 cursor-not-allowed">
              Out Of Stock
            </button>
          <% end %>
        </div>

      </div>
    </div>
  </div>
</div>