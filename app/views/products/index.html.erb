<div class="max-w-7xl mx-auto px-6 py-8">

  <h1 class="text-4xl font-bold text-center mb-10">
    Latest Shirts
  </h1>

  <% if @products.any? %>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">

      <% @products.each do |product| %>

        <div class="bg-white rounded-xl shadow-md hover:shadow-xl transition duration-300 overflow-hidden">

          <% if product.product_images.attached? %>

            <%= image_tag product.product_images.first,
                class: "w-full h-64 object-cover" %>

          <% else %>

            <div class="w-full h-64 bg-gray-200 flex items-center justify-center text-gray-500">
              No Image Available
            </div>

          <% end %>

          <div class="p-5">

            <h3 class="text-xl font-semibold mb-2">
              <%= product.title %>
            </h3>

            <p class="text-2xl font-bold text-green-600 mb-4">
              ₹<%= product.price %>
            </p>

            <%= link_to "View Product",
                product_path(product),
                class: "block text-center bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg font-medium transition" %>

          </div>

        </div>

      <% end %>

    </div>

  <% else %>

    <div class="bg-white rounded-xl shadow-md p-10 text-center">

      <h2 class="text-2xl font-semibold text-gray-700 mb-3">
        No Products Available
      </h2>

      <p class="text-gray-500">
        Products added by admin will appear here.
      </p>

    </div>

  <% end %>

</div>