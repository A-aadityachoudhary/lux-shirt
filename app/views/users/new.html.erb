<div class="max-w-md mx-auto mt-12 px-4">
  <div class="bg-[#12131c]/90 border border-gray-800 rounded-3xl p-8 shadow-[0_25px_50px_rgba(0,0,0,0.5)] backdrop-blur-sm">

    <h1 class="text-3xl font-extrabold text-center text-white mb-8 tracking-tight">
      Create Account
    </h1>

    <%= form_with model: @user, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :name,
            class: "block text-sm font-semibold text-gray-300 mb-2" %>
        <%= f.text_field :name,
            placeholder: "John Doe",
            class: "w-full bg-[#1a1b26] text-white border border-gray-700 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-transparent focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :email_address,
            class: "block text-sm font-semibold text-gray-300 mb-2" %>
        <%= f.email_field :email_address, placeholder: "johndoe@example.com",
            class: "w-full bg-[#1a1b26] text-white border border-gray-700 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-transparent focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :password,
            class: "block text-sm font-semibold text-gray-300 mb-2" %>
        <%= f.password_field :password,
            placeholder: "Minimum 6 characters",
            class: "w-full bg-[#1a1b26] text-white border border-gray-700 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-transparent focus:outline-none transition" %>
      </div>

      <div>
        <%= f.label :password_confirmation,
            class: "block text-sm font-semibold text-gray-300 mb-2" %>
        <%= f.password_field :password_confirmation,
            placeholder: "Confirm password",
            class: "w-full bg-[#1a1b26] text-white border border-gray-700 rounded-xl px-4 py-2.5 focus:ring-2 focus:ring-emerald-500 focus:border-transparent focus:outline-none transition" %>
      </div>

      <div class="pt-4">
        <%= f.submit "Create Account",
            class: "w-full bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold py-3.5 rounded-xl shadow-lg shadow-emerald-600/20 transform hover:-translate-y-0.5 transition duration-200 cursor-pointer tracking-wide" %>
      </div>
    <% end %>

    <div class="mt-8 pt-6 border-t border-gray-800 text-center text-sm text-gray-400">
      Already have an account?
      <%= link_to "Login",
          new_session_path,
          class: "text-indigo-400 hover:text-indigo-300 font-bold transition ml-1" %>
    </div>

  </div>
</div>