<div class="max-w-7xl mx-auto px-4 py-8">

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
    <h1 class="text-4xl font-extrabold tracking-tight bg-gradient-to-r from-white to-gray-400 bg-clip-text text-transparent">
      Admin Products Control
    </h1>

    <%= link_to new_admin_product_path,
        class: "bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white px-5 py-3 rounded-xl font-bold shadow-[0_4px_15px_rgba(79,70,229,0.3)] transform hover:-translate-y-0.5 transition duration-200 flex items-center gap-2" do %>
      <span>➕</span> Add Premium Product
    <% end %>
  </div>

  <div class="bg-[#12131c]/90 border border-gray-800/80 rounded-2xl shadow-[0_20px_40px_rgba(0,0,0,0.4)] overflow-hidden backdrop-blur-md">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-800/60">
        <thead class="bg-[#1a1b26]/70">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Image</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Title</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Price</th>
            <th class="px-6 py-4 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Stock Status</th>
            <th class="px-6 py-4 text-right text-xs font-bold text-gray-400 uppercase tracking-wider">Operations</th>
          </tr>
        </thead>

        <tbody class="divide-y divide-gray-800/40 bg-transparent">
          <% @products.each do |product| %>
            <tr class="hover:bg-gray-800/20 transition-colors duration-150">
              <td class="px-6 py-4 whitespace-nowrap">
                <% if product.product_images.attached? %>
                  <%= image_tag product.product_images.first,
                      class: "w-16 h-16 object-cover rounded-xl border border-gray-700/60 shadow-md" %>
                <% else %>
                  <div class="w-16 h-16 bg-[#1a1b26] border border-gray-800 rounded-xl flex items-center justify-center text-xs text-gray-500 font-medium">
                    No Image
                  </div>
                <% end %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap font-semibold text-white tracking-wide">
                <%= product.title %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap text-emerald-400 font-extrabold text-lg">
                ₹<%= product.price %>
              </td>

              <td class="px-6 py-4 whitespace-nowrap">
                <% if product.stock > 0 %>
                  <span class="inline-flex items-center gap-1.5 bg-emerald-950/60 border border-emerald-500/20 text-emerald-400 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                    <%= product.stock %> Available
                  </span>
                <% else %>
                  <span class="inline-flex items-center gap-1.5 bg-rose-950/60 border border-rose-500/20 text-rose-400 px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-rose-400"></span>
                    Out of Stock
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="inline-flex items-center gap-3">
                  <%= link_to "Edit", edit_admin_product_path(product), 
                      class: "text-indigo-400 hover:text-indigo-300 font-bold tracking-wide text-xs uppercase bg-indigo-950/40 border border-indigo-500/30 px-3 py-1.5 rounded-xl transition" %>
                  
                  <%= button_to "Delete", admin_product_path(product), 
                      method: :delete, 
                      data: { confirm: "Are you certain you want to destroy this entry?" }, 
                      class: "text-rose-400 hover:text-rose-300 font-bold tracking-wide text-xs uppercase bg-rose-950/40 border border-rose-500/30 px-3 py-1.5 rounded-xl transition cursor-pointer" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

</div>